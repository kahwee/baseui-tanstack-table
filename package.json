{
  "name": "baseui-data-table",
  "version": "1.0.1",
  "description": "A data table component for BaseUI using TanStack Table",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2"
  },
  "main": "dist/baseui-data-table.umd.js",
  "module": "dist/baseui-data-table.es.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "storybook": "storybook dev -p 6006",
    "storybook:clean": "storybook dev -p 6006 --no-cache",
    "build-storybook": "storybook build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kahwee/baseui-data-table.git"
  },
  "keywords": [
    "baseui",
    "react",
    "table",
    "data-table",
    "tanstack-table"
  ],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/kahwee/baseui-data-table/issues"
  },
  "homepage": "https://github.com/kahwee/baseui-data-table#readme",
  "dependencies": {
    "@tanstack/match-sorter-utils": "^9.1.2",
    "@tanstack/react-table": "^9.2.4",
    "baseui": "^18.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "styletron-engine-atomic": "^1.6.2",
    "styletron-react": "^6.1.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "eslint": "^10.10.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.6.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.0.1",
    "storybook": "^10.6.0",
    "typescript": "6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "@types/react": "$@types/react",
    "@types/react-dom": "$@types/react-dom",
    "brace-expansion": "5.0.9",
    "nanoid": "3.3.18",
    "js-yaml": "4.3.1"
  }
}
